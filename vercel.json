{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__vercel_route=$1"
    },
    {
      "source": "/master",
      "destination": "/master.html"
    },
    {
      "source": "/admin",
      "destination": "/master.html"
    },
    {
      "source": "/member",
      "destination": "/member.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
